---
/**
 * The static half of the contact block (DESIGN_SYSTEM.md §22).
 *
 * Extracted from ContactCTA.astro in P2.2 so project pages can end on the
 * same invitation the homepage does without inheriting the form. The form is
 * a React island, and project routes are required to hydrate nothing; copying
 * this markup into a second, project-only component would have meant two
 * places to keep the same copy and the same styling correct.
 *
 * So: this component owns the heading, the supporting line, the email and the
 * three destinations. ContactCTA composes it beside <ContactForm />, and
 * ProjectLayout renders it alone.
 *
 * It sets no `id` of its own beyond the heading, and the heading's id is a
 * prop, because the homepage section and the project section label themselves
 * from it and must not both claim the same anchor.
 */
import { CONTACT } from '@/lib/copy';
import { RESUME_AVAILABLE, RESUME_PATH, SITE } from '@/lib/site';

interface Props {
  /** Id for the heading, referenced by the containing section. */
  headingId?: string;
  /**
   * Smaller heading for a page that is already ending. A project page closes
   * on the project navigation, and a full section-scale heading under it
   * shouted louder than the case study it was following.
   */
  compact?: boolean;
}

const { headingId = 'contact-heading', compact = false } = Astro.props;
---

<div class:list={['contact-lead-body', { 'is-compact': compact }]}>
  <h2 id={headingId} class="display contact-heading">
    {CONTACT.heading}
  </h2>

  <p class="contact-supporting">{CONTACT.supporting}</p>

  <a href={`mailto:${SITE.email}`} class="contact-email">
    {SITE.email}
  </a>

  <ul class="contact-links">
    <li>
      <a href={SITE.github} class="contact-link" target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
    </li>
    <li>
      <a href={SITE.linkedin} class="contact-link" target="_blank" rel="noopener noreferrer">
        LinkedIn
      </a>
    </li>
    <li>
      {RESUME_AVAILABLE ? (
        <a href={RESUME_PATH} class="contact-link" download>
          Resume
        </a>
      ) : (
        <span class="contact-link is-unavailable">Resume coming soon</span>
      )}
    </li>
  </ul>
</div>

<style>
  .contact-heading {
    font-size: var(--text-section);
    text-transform: uppercase;
    max-width: 16ch;
  }

  .contact-supporting {
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    font-size: var(--text-body-lg);
    line-height: 1.55;
    color: var(--color-graphite-text);
    max-width: 46ch;
  }

  .contact-email {
    /* Flex with a min-height so the primary contact action clears the 44px
       target rule even at the smallest type size (§33). */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-deck);
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-oxide-rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    word-break: break-word;
    transition: text-decoration-thickness var(--motion-fast) var(--ease-standard);
  }

  .contact-email:hover {
    text-decoration-thickness: 3px;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--text-meta-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-graphite-rule);
    text-underline-offset: 0.3em;
    transition:
      text-decoration-color var(--motion-fast) var(--ease-standard),
      text-decoration-thickness var(--motion-fast) var(--ease-standard);
  }

  .contact-link:hover {
    text-decoration-color: var(--color-oxide-rule);
    text-decoration-thickness: 2px;
  }

  .is-unavailable {
    color: var(--color-graphite-text);
    text-decoration: none;
    cursor: default;
  }

  /* --- Compact --- */
  .is-compact .contact-heading {
    font-size: var(--text-index);
    max-width: 20ch;
  }

  .is-compact .contact-supporting {
    margin-top: 1rem;
    font-size: var(--text-body);
    max-width: 52ch;
  }

  .is-compact .contact-email {
    margin-top: 1.25rem;
    font-size: var(--text-body-lg);
  }

  .is-compact .contact-links {
    margin-top: 1rem;
  }
</style>
