---
/**
 * Sticky editorial navigation (DESIGN_SYSTEM.md §10).
 *
 * Left: wordmark. Right: four destinations. Thin bottom rule, Paper ground,
 * low height. Never a floating pill.
 *
 * Narrow widths use a native <details> disclosure rather than a scripted
 * menu. It is keyboard operable, works with JavaScript disabled, announces
 * its own expanded state, and needs no focus trap because it is not modal.
 * The script at the bottom of this file adds only the three things the
 * element genuinely lacks (Escape, close-on-choose, and not reopening itself
 * after a back-navigation); it never takes over opening or closing.
 */
import { NAV_ITEMS } from '@/lib/copy';
import { SITE } from '@/lib/site';
---

<header class="site-nav">
  <nav class="container nav-inner" aria-label="Primary">
    <a href="#top" class="wordmark">
      {SITE.name}
    </a>

    <ul class="nav-list">
      {NAV_ITEMS.map((item) => (
        <li>
          <a href={item.href} class="nav-link">
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <details class="nav-disclosure">
      <summary aria-label="Menu">
        <span class="label label-ink">Menu</span>
      </summary>
      <ul class="nav-panel">
        {NAV_ITEMS.map((item) => (
          <li>
            <a href={item.href} class="nav-panel-link">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-paper);
    border-bottom: var(--border-thin) solid var(--color-graphite-rule);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--nav-height);
  }

  .wordmark {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink);
    /* Keeps the wordmark a 44px target without inflating the bar. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .nav-list {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: clamp(1.25rem, 3vw, 2.75rem);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    /* 13px rather than 12px: these are primary navigation targets, not
       incidental metadata, and still inside the §05 technical range. */
    font-size: var(--text-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-graphite-text);
    transition: color var(--motion-fast) var(--ease-standard);
  }

  /* The rule is drawn rather than switched on: it grows from the leading
     edge of the word, which is the same gesture the section rules use.
     Colour still changes alongside it, so the state never depends on
     noticing a one-pixel line. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 1px;
    background-color: var(--color-oxide-rule);
    scale: 0 1;
    transform-origin: left center;
    transition: scale var(--motion-base) var(--ease-standard);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-ink);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    scale: 1 1;
  }

  /* --- Mobile disclosure --- */
  .nav-disclosure summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.25rem;
    cursor: pointer;
    list-style: none;
  }

  .nav-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .nav-disclosure[open] summary .label {
    color: var(--color-oxide-text);
  }

  .nav-panel {
    position: absolute;
    left: 0;
    right: 0;
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--page-gutter) 1.25rem;
    background-color: var(--color-paper);
    border-bottom: var(--border-thin) solid var(--color-graphite-rule);
  }

  .nav-panel-link {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink);
    border-bottom: var(--border-thin) solid var(--color-paper-soft);
  }

  .nav-panel li:last-child .nav-panel-link {
    border-bottom: 0;
  }

  /* --- Where the real navigation starts -----------------------------------
     Measured, not assumed. With the desktop list forced on and the web font
     loaded, the distance between the wordmark and the first link runs:

       480px   wordmark wraps to two lines        unusable
       520px   26px between wordmark and links    cramped
       560px   63px                               tight
       600px   100px                              comfortable
       640px   137px                              comfortable
       768px   245px                              comfortable

     So the bar physically fits from about 520 and reads comfortably from 600.
     640 is the switch: it keeps roughly 40px of margin over the first
     comfortable width, which covers the difference between IBM Plex Mono and
     whatever fallback is rendering before the font arrives, and it is the
     point where the container stops tracking the viewport and settles onto a
     stepped width, so the spacing above it is predictable.

     The old value was 1024, which handed a hamburger to every tablet and
     small laptop window that had room for the real thing several hundred
     pixels earlier. */
  @media (min-width: 640px) {
    .nav-list {
      display: flex;
    }

    .nav-disclosure {
      display: none;
    }
  }
</style>

<script>
  /**
   * Three behaviours the native disclosure does not provide on its own.
   *
   * Everything else is left to <details>: it opens, closes, is keyboard
   * operable and announces its own expanded state without help, and it all
   * still works with this script absent. There is no focus trap, because the
   * panel is not modal, and no global key handler: the listener below is
   * bound to the <details> element, so Escape anywhere else on the page is
   * none of this component's business.
   */
  const nav = document.querySelector<HTMLDetailsElement>('.nav-disclosure');

  if (nav) {
    const summary = nav.querySelector('summary');

    const close = (returnFocus: boolean) => {
      if (!nav.open) return;
      nav.open = false;
      // Escape is a dismissal, so focus goes back to the control that opened
      // the panel rather than being dropped on <body>. Following a link is
      // not a dismissal: there the destination should keep the focus.
      if (returnFocus) summary?.focus();
    };

    // 1. Escape closes it. <details> has no native Escape handling.
    nav.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close(true);
    });

    // 2. Choosing a destination closes it. Every link here is a same-page
    //    anchor, so nothing unloads and the panel would otherwise stay open
    //    over the section the reader just asked for.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) close(false);
    });

    // 3. Coming back to the page must not restore a panel left open. A
    //    bfcache restore returns the DOM exactly as it was, open attribute
    //    included, which reads as the menu having opened by itself.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) close(false);
    });

    // Widening past the breakpoint hides the disclosure while leaving it
    // open, so it would be open again on the way back down.
    window.matchMedia('(min-width: 640px)').addEventListener('change', (event) => {
      if (event.matches) close(false);
    });
  }
</script>
