---
/**
 * The documented graph vocabulary (P2.4, Legal NLP).
 *
 * DESIGN_SYSTEM §55 says the graph is this project's visual identity, and
 * until now the project had no representation of it at all: the node types
 * and the edge types existed as two comma-separated strings, one inside an
 * architecture stage's detail line and one inside a prose paragraph.
 *
 * This is a vocabulary, not a drawing, and that is a factual constraint
 * rather than a stylistic one. MASTER_CONTENT.md §09 lists five node types,
 * four edge types and three analytics, but nothing anywhere states which node
 * types a given edge connects: no source says CITES runs case to case, or
 * that DECIDED_BY targets a court rather than a judge. Any drawn graph would
 * have to place those endpoints, and every placement would be invented. So
 * the block names the three sets and connects nothing.
 *
 * Which also means there is no picture to provide a text equivalent for. The
 * markup is the content: three labelled lists of terms.
 */
interface Set {
  label: string;
  items: string[];
}

interface Props {
  sets: Set[];
  note?: string | undefined;
}

const { sets, note } = Astro.props;

/** Stable, readable ids so each list is named by its own visible label. */
const setId = (label: string) => `schema-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<div class="schema">
  <div class="schema-sets">
    {sets.map((set) => (
      <section class="schema-set" aria-labelledby={setId(set.label)}>
        <p class="label schema-set-label" id={setId(set.label)}>
          {set.label}
        </p>
        <ul class="schema-items">
          {set.items.map((item) => (
            <li class="schema-item">{item}</li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  {note && <p class="schema-note">{note}</p>}
</div>

<style>
  .schema {
    padding-top: 0.875rem;
    border-top: var(--border-thin) solid var(--color-graphite-rule);
  }

  .schema-sets {
    display: grid;
    gap: 0;
  }

  .schema-set {
    padding-block: clamp(1rem, 2.5vw, 1.375rem);
    border-top: var(--border-thin) solid var(--color-paper-soft);
  }

  .schema-set:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .schema-set-label {
    color: var(--color-oxide-text);
  }

  .schema-items {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    /* A row of terms separated by space and a hairline, not a row of pills:
       the terms are vocabulary, and a filled chip would make each one look
       like a control (§58). */
    gap: 0.375rem 0;
  }

  .schema-item {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    line-height: 1.4;
    color: var(--color-ink);
    padding-right: 0.875rem;
    margin-right: 0.875rem;
    border-right: var(--border-thin) solid var(--color-graphite-rule);
  }

  .schema-item:last-child {
    padding-right: 0;
    margin-right: 0;
    border-right: 0;
  }

  .schema-note {
    margin-top: 0.875rem;
    padding-top: 0.6875rem;
    border-top: var(--border-thin) solid var(--color-graphite-rule);
    font-size: var(--text-meta);
    line-height: 1.55;
    color: var(--color-graphite-text);
    max-width: 66ch;
  }

  /* Three sets side by side once there is room for them, so the vocabulary
     reads as one object rather than three stacked lists. */
  @media (min-width: 768px) {
    .schema-sets {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }

    .schema-set {
      border-top: 0;
      padding-top: 0;
    }

    .schema-items {
      display: grid;
      gap: 0.375rem;
    }

    .schema-item {
      padding-right: 0;
      margin-right: 0;
      border-right: 0;
    }
  }
</style>
