---
/**
 * Compact architecture schematic for a project index row.
 *
 * A small sibling of ArchitectureStages.astro, built the same way for the same
 * reason (§33): it is a semantic ordered list styled into a rail, not a
 * picture. That means it reads correctly with CSS unavailable, in reading
 * mode, and in a screen reader without needing a parallel text description,
 * and it keeps its labels at a real type size at every width instead of
 * scaling down with an SVG viewBox.
 *
 * It carries no information of its own. Every node is a stage from the one
 * canonical `architecture` block in the project's own content entry, reached
 * through `rowView()`, which is the same data the detail page draws its full
 * figure from. There is one architecture definition per project and this is a
 * projection of it rather than a second copy.
 *
 * Per §52 the visual language is the one already in use: hairlines, thin
 * outlines, mono labels, and Oxide reserved for the single decision point.
 * The detail text each step carries is deliberately dropped here; at row
 * scale the sequence is the message and the prose belongs on the case study.
 */
import type { RowStage } from '@/lib/architecture';

interface Props {
  /** The architecture's own name, e.g. "Call lifecycle". Names the list. */
  label: string;
  steps: RowStage[];
  /**
   * Set where the project's architecture documents a return path, so the
   * decision node can show that rejection routes backwards. Supplied by the
   * caller from the canonical block; never inferred here.
   */
  loop?: string | undefined;
}

const { label, steps, loop } = Astro.props;
---

<div class="sch">
  <ol class="sch-rail" aria-label={`${label}: architecture`}>
    {steps.map((step, i) => (
      <li class="sch-node" style={`--sch-index: ${i}`}>
        <span class:list={['sch-box', step.gate && 'is-gate']}>
          {step.label}
          {step.gate && loop && (
            <span class="sch-loop">
              <span aria-hidden="true">&#8634;</span>
              {loop}
            </span>
          )}
        </span>
      </li>
    ))}
  </ol>
</div>

<style>
  .sch {
    margin-top: 1.125rem;
  }

  /* A grid rather than a wrapping flex row, because the connectors have to
     know where each line ends. Free wrapping left a hairline pointing into
     the empty space after the last node on a line, which reads as a
     rendering fault. With a fixed column count the line breaks are known, so
     the connector on the last column can simply be turned off. */
  .sch-rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 0.75rem;
    row-gap: 0.375rem;
  }

  .sch-node {
    position: relative;
    display: flex;
  }

  .sch-box {
    flex: 1;
    padding: 0.25rem 0.4375rem;
    border: var(--border-thin) solid var(--color-graphite-rule);
    font-family: var(--font-mono);
    /* Bottom of the §05 technical range. These are labels on a schematic,
       not running metadata, and the sequence has to fit the column. */
    font-size: 0.6875rem;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-graphite-text);
    transition:
      color var(--motion-base) var(--ease-standard),
      border-color var(--motion-base) var(--ease-standard);
  }

  /* Connector, drawn into the column gap so it cannot add width or be
     selected. Suppressed at the end of every line and after the last node. */
  .sch-node::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 100%;
    width: 0.75rem;
    height: 1px;
    background-color: var(--color-graphite-rule);
    transition: background-color var(--motion-base) var(--ease-standard);
  }

  .sch-node:nth-child(2n)::after,
  .sch-node:last-child::after {
    content: none;
  }

  .is-gate {
    border-color: var(--color-oxide-rule);
    color: var(--color-oxide-text);
  }

  /* The documented return path at the decision point. Text, not a drawn arc:
     at this size an arc is a smudge, and the word survives wrapping. */
  .sch-loop {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    margin-left: 0.4375em;
    color: var(--color-oxide-text);
  }

  /* Three columns once the headline column is wide enough to carry them.
     The nth-child rule has to be restated in both directions: the two-column
     break is switched back on before the three-column one is switched off. */
  @media (min-width: 1024px) {
    .sch-rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .sch-node:nth-child(2n)::after {
      content: '';
    }

    .sch-node:nth-child(3n)::after,
    .sch-node:last-child::after {
      content: none;
    }
  }

  /* Tighter below the hover breakpoint. There the schematic is always on
     screen rather than revealed, so its height is height the reader pays on
     every row: trimming the padding and the gaps takes roughly 25px per row
     off a phone without making the labels any harder to read. */
  @media (hover: none) {
    .sch {
      margin-top: 0.875rem;
    }

    .sch-rail {
      column-gap: 0.625rem;
      row-gap: 0.25rem;
    }

    .sch-box {
      padding: 0.1875rem 0.375rem;
    }

    .sch-node::after {
      width: 0.625rem;
    }
  }
</style>
