---
/**
 * Figure plate.
 *
 * Renders project media where it exists, and a documentation plate where it
 * does not. No project currently has a screenshot (REBUILD_PLAN gaps 1, 7-14),
 * and fabricating one is forbidden.
 *
 * The empty state is deliberately a *specimen plate*: registration ticks, a
 * figure number, and a caption naming the artefact that will occupy it. It
 * reads as a documentation frame awaiting a plate rather than a broken image,
 * so the composition stays intentional until real captures arrive.
 *
 * To fill one later: pass `src` (an image imported from src/assets) and `alt`.
 * Nothing else about the layout needs to change.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Figure number, e.g. "01". Rendered as "FIG. 01". */
  figure: string;
  /** What the figure shows or will show. Also used as the caption. */
  caption: string;
  /** Imported image. Omit to render the awaiting-capture plate. */
  src?: ImageMetadata;
  /** Required whenever `src` is supplied. */
  alt?: string;
  /** CSS aspect-ratio for the frame, e.g. "16 / 10". */
  ratio?: string;
  /** Above-the-fold images should not lazy-load. */
  eager?: boolean;
  /** Rendered width hint for the image pipeline. */
  widths?: number[];
  sizes?: string;
}

const {
  figure,
  caption,
  src,
  alt,
  ratio = '16 / 10',
  eager = false,
  widths = [480, 768, 1024, 1440],
  sizes = '(min-width: 1024px) 60vw, 100vw',
} = Astro.props;
---

<figure class="figure">
  {src && alt ? (
    <div class="frame" style={`aspect-ratio: ${ratio};`}>
      <Image
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        class="frame-image"
      />
    </div>
  ) : (
    <div
      class="plate"
      style={`aspect-ratio: ${ratio};`}
      role="img"
      aria-label={`Figure ${figure} placeholder: ${caption}. Capture pending.`}
    >
      <div class="plate-body">
        {/* Ink, not Oxide. The plate ground is Soft Paper, where Oxide text
              at this size measures 4.50:1 and misses AA. Ink gives 13.06:1. */}
        <p class="label label-ink">FIG. {figure}</p>
        <p class="plate-caption">{caption}</p>
        <p class="label plate-status">Capture pending</p>
      </div>
    </div>
  )}

  <figcaption class="figcap">
    <span class="label label-ink">FIG. {figure}</span>
    <span class="figcap-text">{caption}</span>
  </figcaption>
</figure>

<style>
  .figure {
    margin: 0;
  }

  .frame {
    border: var(--border-thin) solid var(--color-ink);
    background-color: var(--color-paper-soft);
    overflow: hidden;
  }

  .frame-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .plate-caption {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-ink);
    line-height: 1.45;
  }

  .plate-status {
    font-size: var(--text-meta-sm);
    color: var(--color-graphite-text);
  }

  .figcap-text {
    font-family: var(--font-body);
    font-size: var(--text-meta);
    color: var(--color-graphite-text);
  }
</style>
