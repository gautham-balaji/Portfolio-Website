---
/**
 * Secondary project row (DESIGN_SYSTEM.md §13).
 *
 * An editorial index entry, not a card: number, title, positioning, descriptor,
 * and metadata across a single ruled row. Deliberately text-led and without
 * media, so the flagship above it keeps its visual weight.
 *
 * Everything needed to understand the project is present at rest. The
 * architecture schematic is the one thing hover and focus add, which §25
 * sanctions for exactly this element ("preview image appears or changes"),
 * under its own condition: the row must not require hover to be understood,
 * and it does not. §40 forbids hover-dependent previews on mobile, so below
 * the hover breakpoint the schematic is simply always visible.
 *
 * Where a project has no public repository, no link is rendered and the reason
 * is stated, because MASTER_CONTENT.md §10 and §23 forbid inventing URLs.
 */
import type { CollectionEntry } from 'astro:content';
import RowSchematic from '@/components/project/RowSchematic.astro';
import { rowView } from '@/lib/architecture';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, order, status, year, role, positioning, descriptor, technologies, github } =
  project.data;

const number = String(order).padStart(2, '0');

/* The compact projection of the one canonical architecture. Stage names and
   the return path come from the same content entry the detail page draws, so
   there is exactly one place that knows GeoCounterfactual's critic loops back
   and the others do not. Before P2.1 this row had to read two sources to
   assemble the same thing. */
const schematic = rowView(project);
---

<article class="row" data-reveal>
  <hr class="rule" />

  <div class="grid-12 row-grid">
    <p class="label row-number">{number}</p>

    <div class="row-headline">
      {/* The title is the link to the case study. A real anchor makes every
          project keyboard reachable and announceable, which a div with a click
          handler never was. */}
      <h3 class="display row-title">
        <a href={`/projects/${project.id}`} class="row-title-link">
          {title}
        </a>
      </h3>
      <p class="row-positioning">{positioning}</p>

      {schematic && (
        <div class="row-schematic">
          <RowSchematic
            label={schematic.label}
            steps={schematic.steps}
            loop={schematic.loop}
          />
        </div>
      )}
    </div>

    <p class="row-descriptor">{descriptor}</p>

    <div class="row-meta">
      <p class="label">
        {year} / {status.toUpperCase()}
      </p>
      <p class="label">ROLE / {role.toUpperCase()}</p>
      <p class="label row-stack">{technologies.slice(0, 4).join(' / ').toUpperCase()}</p>

      <a href={`/projects/${project.id}`} class="row-link">
        Read case study
      </a>

      {github ? (
        <a
          href={github}
          class="row-link row-link-muted"
          target="_blank"
          rel="noopener noreferrer"
        >
          View source
        </a>
      ) : (
        <p class="label row-nolink">No public repository</p>
      )}
    </div>
  </div>
</article>

<style>
  /* --- Engaged row -------------------------------------------------------
     Hover or keyboard focus anywhere in the row emphasises the whole entry:
     the rule takes Oxide, the number and title step right, and the metadata
     rail darkens from Graphite to Ink.

     Every one of those is emphasis on information that is already present and
     already legible. Nothing here is disclosure: §25 and §40 both require the
     row to be fully understandable without hovering it, which is also why the
     keyboard gets the identical treatment through :focus-within rather than a
     reduced version of it. */
  .row .rule {
    transition: border-top-color var(--motion-base) var(--ease-standard);
  }

  .row:hover .rule,
  .row:focus-within .rule {
    border-top-color: var(--color-oxide-rule);
  }

  .row-number,
  .row-headline {
    transition: translate var(--motion-base) var(--ease-standard);
  }

  .row:hover .row-number,
  .row:focus-within .row-number,
  .row:hover .row-headline,
  .row:focus-within .row-headline {
    translate: 0.25rem 0;
  }

  .row-meta .label {
    transition: color var(--motion-base) var(--ease-standard);
  }

  .row:hover .row-meta .label,
  .row:focus-within .row-meta .label {
    color: var(--color-ink);
  }

  /* --- Schematic reveal --------------------------------------------------
     The schematic sits in space the headline column already had spare: the
     metadata rail beside it is the taller column at every width from 768 up,
     by 39px to 74px. Occupying slack rather than adding a band is what keeps
     this from lengthening the page, and reserving the space whether or not
     the row is engaged is what keeps the reveal free of layout shift.

     Visible by default. The hover treatment is added only where hover
     actually exists, so a touch reader is never shown a preview that needs a
     pointer to appear (§40) and a desktop reader gets the reveal §25 allows. */
  .row-schematic {
    transition:
      opacity var(--motion-base) var(--ease-standard),
      translate var(--motion-base) var(--ease-standard);
  }

  /* All three conditions have to hold before the schematic is hidden at rest,
     and the width one was added after visual QA: a desktop browser narrowed
     to 390px still reports hover and a fine pointer, so the rail stayed at
     opacity 0 while its 99px of reserved space remained, leaving a hole in a
     615px row. A window that narrow is mobile whatever the pointer is.

     Left as a conjunction on purpose. A touch tablet wider than 1024px has
     no hover, so this block does not match there either and the schematic
     stays visible, which is the case §40 actually cares about. */
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
    .row-schematic {
      opacity: 0;
      translate: 0 0.25rem;
    }

    .row:hover .row-schematic,
    .row:focus-within .row-schematic {
      opacity: 1;
      translate: none;
    }
  }

  /* Asked for less motion: the schematic is simply there, on every device,
     with nothing to wait for and nothing to trigger. */
  @media (prefers-reduced-motion: reduce) {
    .row-schematic {
      opacity: 1;
      translate: none;
    }
  }

  .row-grid {
    padding-block: clamp(1.75rem, 4vw, 3rem);
    align-items: start;
  }

  .row-number {
    grid-column: 1 / -1;
    color: var(--color-oxide-text);
  }

  .row-headline,
  .row-descriptor,
  .row-meta {
    grid-column: 1 / -1;
  }

  .row-title {
    /* Capped deliberately. "GEOCOUNTERFACTUAL" is a single 17-character word
       that cannot wrap, so the scale must let it fit its column at every
       breakpoint. break-word is the safety net, not the plan. */
    font-size: var(--text-index);
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  .row-positioning {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.0625rem, 1.7vw, 1.375rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-top: 0.625rem;
    max-width: 28ch;
  }

  .row-descriptor {
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--color-graphite-text);
    max-width: 56ch;
  }

  .row-meta {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .row-stack {
    color: var(--color-ink);
  }

  .row-link {
    align-self: flex-start;
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--text-meta-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-graphite-rule);
    text-underline-offset: 0.3em;
    transition:
      text-decoration-color var(--motion-fast) var(--ease-standard),
      text-decoration-thickness var(--motion-fast) var(--ease-standard);
  }

  .row-link:hover {
    text-decoration-color: var(--color-oxide-rule);
    text-decoration-thickness: 2px;
  }

  .row-title-link {
    color: inherit;
    text-decoration: none;
  }

  .row-title-link:hover {
    color: var(--color-oxide-text);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  .row-link-muted {
    margin-top: 0;
    color: var(--color-graphite-text);
  }

  .row-nolink {
    margin-top: 0;
    font-style: normal;
    color: var(--color-graphite-text);
  }

  @media (min-width: 768px) {
    .row-number {
      grid-column: 1 / span 1;
    }

    .row-headline {
      grid-column: 2 / span 6;
    }

    .row-descriptor {
      grid-column: 8 / span 5;
    }

    .row-meta {
      grid-column: 8 / span 5;
      margin-top: 0.25rem;
    }
  }

  @media (min-width: 1024px) {
    /* Columns must not be shared: descriptor ends at 9, meta starts at 10.
       The long single-word title is handled by the type scale above, not by
       widening this column into the metadata rail. */
    .row-headline {
      grid-column: 2 / span 5;
    }

    .row-descriptor {
      grid-column: 7 / span 3;
    }

    .row-meta {
      grid-column: 10 / span 3;
      margin-top: 0;
    }
  }
</style>

<style is:global>
  /* --- Schematic stagger --------------------------------------------------
     The nodes arrive left to right, 14ms apart, so the rail reads as the
     direction of the flow rather than as a block switching on. The whole
     sequence is inside 320ms for the longest rail on the page.

     Global because `.row` is rendered here and the nodes are rendered by
     RowSchematic.astro, either side of Astro's per-component style scoping.
     Same precedent as the index-focus styles in SelectedWork.astro.

     The delay is applied to the reveal only, never to the return: leaving a
     row drops the delay to zero so the schematic goes at once instead of
     unwinding node by node behind the pointer. */
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
    .row-schematic .sch-node {
      opacity: 0;
      transition: opacity var(--motion-base) var(--ease-standard);
    }

    .row:hover .row-schematic .sch-node,
    .row:focus-within .row-schematic .sch-node {
      opacity: 1;
      transition-delay: calc(var(--sch-index, 0) * 14ms);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row-schematic .sch-node {
      opacity: 1;
    }
  }
</style>
