---
/**
 * Architecture diagram.
 *
 * A hand-drawn-style, inline SVG pipeline: rectangular nodes, thin rules,
 * mono labels. Built from the same verified stage data already carried in a
 * project's `flow` frontmatter (or a close variant of it), never invented
 * structure. A stage may hold two nodes stacked to show a fork/join (for
 * example a CNN and classical features feeding one fusion step), and an
 * optional `loopBack` draws the one curved return edge some pipelines need
 * (GeoCounterfactual's critic rejecting back to the generator).
 *
 * No JavaScript, no external requests: the SVG is written directly into the
 * page's DOM, so it inherits the page's CSS custom properties like any other
 * element, and needs no separate light/dark handling.
 *
 * This is not a replacement for FlowDiagram, which reads correctly with CSS
 * disabled. This component is always used inside a <FigurePlate>, whose
 * figcaption already gives the diagram a textual caption; the sibling
 * `.dg-sr` list below repeats the stage and edge structure as plain text so
 * the shapes and arrows are never the only way to read the diagram.
 */
interface Node {
  label: string;
  detail?: string;
}

interface Stage {
  nodes: [Node] | [Node, Node];
  gate?: boolean;
}

interface Props {
  stages: Stage[];
  loopBack?: { from: number; to: number; label: string };
}

const { stages, loopBack } = Astro.props;

const COL_WIDTH = 148;
const GAP = 56;
const PAD = 24;
const CENTER_Y = 120;
const SINGLE_H = 64;
const PAIR_H = 52;
const PAIR_GAP = 16;

const hasLoop = Boolean(loopBack);
const width = PAD * 2 + stages.length * COL_WIDTH + (stages.length - 1) * GAP;
const height = 240 + (hasLoop ? 70 : 0);

function colX(i: number) {
  return PAD + i * (COL_WIDTH + GAP);
}

/** Rough mono-font word wrap for a fixed node width, computed at build time. */
function wrap(text: string, maxChars: number): string[] {
  const words = text.split(' ');
  const lines: string[] = [];
  let current = '';
  for (const word of words) {
    const next = current ? `${current} ${word}` : word;
    if (next.length > maxChars && current) {
      lines.push(current);
      current = word;
    } else {
      current = next;
    }
  }
  if (current) lines.push(current);
  return lines;
}

interface NodeBox {
  x: number;
  y: number;
  w: number;
  h: number;
  labelLines: string[];
  detailLines: string[];
  gate: boolean;
}

const boxes: NodeBox[][] = stages.map((stage, i) => {
  const x = colX(i);
  if (stage.nodes.length === 1) {
    const [node] = stage.nodes;
    return [
      {
        x,
        y: CENTER_Y - SINGLE_H / 2,
        w: COL_WIDTH,
        h: SINGLE_H,
        labelLines: wrap(node.label.toUpperCase(), 16),
        detailLines: node.detail ? wrap(node.detail, 20).slice(0, 3) : [],
        gate: Boolean(stage.gate),
      },
    ];
  }
  const top = CENTER_Y - (PAIR_H * 2 + PAIR_GAP) / 2;
  return stage.nodes.map((node, j) => ({
    x,
    y: top + j * (PAIR_H + PAIR_GAP),
    w: COL_WIDTH,
    h: PAIR_H,
    labelLines: wrap(node.label.toUpperCase(), 16),
    detailLines: node.detail ? wrap(node.detail, 20).slice(0, 1) : [],
    gate: Boolean(stage.gate),
  }));
});

/** Straight connectors between adjacent stages, one line per source/target pair. */
const edges: { x1: number; y1: number; x2: number; y2: number; stage: number }[] = [];
for (let i = 0; i < boxes.length - 1; i++) {
  const from = boxes[i];
  const to = boxes[i + 1];
  if (!from || !to) continue;
  for (const a of from) {
    for (const b of to) {
      edges.push({
        x1: a.x + a.w,
        y1: a.y + a.h / 2,
        x2: b.x,
        y2: b.y + b.h / 2,
        stage: i,
      });
    }
  }
}

const loopPath = (() => {
  if (!loopBack) return null;
  const fromBox = boxes[loopBack.from]?.[0];
  const toBox = boxes[loopBack.to]?.[0];
  if (!fromBox || !toBox) return null;
  const startX = fromBox.x + fromBox.w / 2;
  const startY = fromBox.y + fromBox.h;
  const endX = toBox.x + toBox.w / 2;
  const endY = toBox.y + toBox.h;
  const dipY = height - 30;
  return {
    d: `M ${startX} ${startY} C ${startX} ${dipY}, ${endX} ${dipY}, ${endX} ${endY}`,
    labelX: (startX + endX) / 2,
    labelY: dipY + 4,
  };
})();

/* Plain-text equivalent of the drawing, for anyone not reading the shapes. */
const textStages = stages.map((stage) =>
  stage.nodes.map((n) => n.label + (n.detail ? ` (${n.detail})` : '')).join(' + '),
);
---

<div class="arch" data-reveal="diagram">
  <svg
    class="arch-svg"
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label={`Architecture diagram: ${textStages.join(' leads to ')}${loopBack ? `, with ${loopBack.label} routing back from stage ${loopBack.from + 1} to stage ${loopBack.to + 1}` : ''}.`}
  >
    <defs>
      <marker
        id="arch-arrow"
        viewBox="0 0 8 8"
        refX="7"
        refY="4"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M0,0 L8,4 L0,8 Z" class="arch-arrowhead" />
      </marker>
      <marker
        id="arch-arrow-oxide"
        viewBox="0 0 8 8"
        refX="7"
        refY="4"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M0,0 L8,4 L0,8 Z" class="arch-arrowhead-oxide" />
      </marker>
    </defs>

    {edges.map((edge) => (
      <line
        x1={edge.x1}
        y1={edge.y1}
        x2={edge.x2 - 8}
        y2={edge.y2}
        class="arch-edge arch-stage"
        style={`--stagger: ${edge.stage + 0.5}`}
        marker-end="url(#arch-arrow)"
      />
    ))}

    {loopPath && (
      <>
        <path
          d={loopPath.d}
          class="arch-edge arch-loop arch-stage"
          style={`--stagger: ${boxes.length}`}
          marker-end="url(#arch-arrow-oxide)"
        />
        <text
          x={loopPath.labelX}
          y={loopPath.labelY}
          class="arch-loop-label arch-stage"
          style={`--stagger: ${boxes.length}`}
          text-anchor="middle"
        >
          {loopBack?.label.toUpperCase()}
        </text>
      </>
    )}

    {boxes.map((stageBoxes, stageIndex) =>
      stageBoxes.map((box) => (
        <g class="arch-stage" style={`--stagger: ${stageIndex}`}>
          <rect
            x={box.x}
            y={box.y}
            width={box.w}
            height={box.h}
            class:list={['arch-node', { 'is-gate': box.gate }]}
          />
          <text
            x={box.x + box.w / 2}
            y={box.y + box.h / 2}
            text-anchor="middle"
            class="arch-label"
          >
            {box.labelLines.map((line, li) => (
              <tspan
                x={box.x + box.w / 2}
                dy={li === 0 ? `${-((box.labelLines.length - 1) * 0.55)}em` : '1.1em'}
              >
                {line}
              </tspan>
            ))}
          </text>
          {box.detailLines.length > 0 && (
            <text
              x={box.x + box.w / 2}
              y={box.y + box.h / 2 + (box.labelLines.length * 11 + 12)}
              text-anchor="middle"
              class="arch-detail"
            >
              {box.detailLines.map((line, li) => (
                <tspan x={box.x + box.w / 2} dy={li === 0 ? '0' : '1.1em'}>
                  {line}
                </tspan>
              ))}
            </text>
          )}
        </g>
      )),
    )}
  </svg>

  <ol class="dg-sr">
    {textStages.map((text, i) => (
      <li>
        {text}
        {loopBack?.from === i && ` (on rejection, returns to stage ${loopBack.to + 1})`}
      </li>
    ))}
  </ol>
</div>

<style>
  .arch {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .arch-svg {
    width: 100%;
    height: auto;
    max-height: 100%;
  }

  .arch-node {
    fill: var(--color-paper);
    stroke: var(--color-ink);
    stroke-width: 1;
  }

  .arch-node.is-gate {
    stroke: var(--color-oxide-rule);
    stroke-width: 1.5;
  }

  .arch-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    fill: var(--color-ink);
  }

  .arch-detail {
    font-family: var(--font-body);
    font-size: 8px;
    fill: var(--color-graphite-text);
  }

  .arch-edge {
    stroke: var(--color-graphite-rule);
    stroke-width: 1;
    fill: none;
  }

  .arch-loop {
    stroke: var(--color-oxide-rule);
  }

  .arch-loop-label {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.06em;
    fill: var(--color-oxide-text);
  }

  .arch-arrowhead {
    fill: var(--color-graphite-rule);
  }

  .arch-arrowhead-oxide {
    fill: var(--color-oxide-rule);
  }

  /* Visually hidden, not display:none: the structure is still real content,
     just delivered as text instead of shapes. */
  .dg-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
