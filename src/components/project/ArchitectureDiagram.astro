---
/**
 * Architecture drawing: topology only.
 *
 * A hand-drawn-style inline SVG of one project's pipeline, built from the
 * canonical `architecture` block in that project's content entry. Rectangular
 * nodes, thin rules, mono labels. A stage may hold two nodes stacked to show a
 * fork that rejoins (the chess CNN beside the classical features, the two
 * Legal NLP retrieval signals), and a documented return edge is drawn as one
 * curved path (GeoCounterfactual's critic rejecting back to the generator).
 *
 * P2.1 removed the per-node detail text from this drawing. It never fitted:
 * the boxes are a fixed 148px wide and the detail baselines were computed from
 * the label count, so a two-line label pushed its own detail out of the bottom
 * of the box, a three-line detail overflowed, and a paired node's detail
 * landed in the gap between the two rectangles. The response had been to
 * abbreviate the content until it fitted, which is how the drawing came to
 * describe a slightly different system from the list beside it. The detail now
 * lives in ArchitectureStages.astro, at a real type size, where it can wrap.
 *
 * So this component draws structure and nothing else, and it is never the only
 * account of the architecture: it is always rendered inside a FigurePlate
 * whose legend slot carries the full stage list as text.
 *
 * No JavaScript, no external requests. The SVG is written straight into the
 * page, so it inherits the page's custom properties like any other element.
 */
import type { ArchitectureStage } from '@/lib/architecture';
import type { ResolvedLoop } from '@/lib/architecture';
import { stageLabel } from '@/lib/architecture';

interface Props {
  stages: ArchitectureStage[];
  loop?: ResolvedLoop | undefined;
}

const { stages, loop } = Astro.props;

const COL_WIDTH = 148;
const GAP = 56;
const PAD = 24;
/* Node heights carry labels only now, so they are shorter than they were when
   they also had to hold three lines of 8px detail text. */
const SINGLE_H = 52;
const PAIR_H = 44;
const PAIR_GAP = 16;
const CENTER_Y = 70;

const hasLoop = Boolean(loop);
const width = PAD * 2 + stages.length * COL_WIDTH + (stages.length - 1) * GAP;
const height = CENTER_Y * 2 + (hasLoop ? 60 : 0);

function colX(i: number) {
  return PAD + i * (COL_WIDTH + GAP);
}

/** Rough mono-font word wrap for a fixed node width, computed at build time. */
function wrap(text: string, maxChars: number): string[] {
  const words = text.split(' ');
  const lines: string[] = [];
  let current = '';
  for (const word of words) {
    const next = current ? `${current} ${word}` : word;
    if (next.length > maxChars && current) {
      lines.push(current);
      current = word;
    } else {
      current = next;
    }
  }
  if (current) lines.push(current);
  return lines;
}

interface NodeBox {
  id: string;
  x: number;
  y: number;
  w: number;
  h: number;
  labelLines: string[];
  gate: boolean;
}

const boxes: NodeBox[][] = stages.map((stage, i) => {
  const x = colX(i);
  const nodes = stage.nodes;

  if (!nodes) {
    return [
      {
        id: stage.id,
        x,
        y: CENTER_Y - SINGLE_H / 2,
        w: COL_WIDTH,
        h: SINGLE_H,
        labelLines: wrap(stageLabel(stage).toUpperCase(), 16),
        gate: stage.gate,
      },
    ];
  }

  const top = CENTER_Y - (PAIR_H * 2 + PAIR_GAP) / 2;
  return nodes.map((node, j) => ({
    id: node.id,
    x,
    y: top + j * (PAIR_H + PAIR_GAP),
    w: COL_WIDTH,
    h: PAIR_H,
    labelLines: wrap(node.label.toUpperCase(), 16),
    gate: stage.gate,
  }));
});

/** Straight connectors between adjacent stages, one line per source/target pair. */
const edges: { x1: number; y1: number; x2: number; y2: number; stage: number }[] = [];
for (let i = 0; i < boxes.length - 1; i++) {
  const from = boxes[i];
  const to = boxes[i + 1];
  if (!from || !to) continue;
  for (const a of from) {
    for (const b of to) {
      edges.push({
        x1: a.x + a.w,
        y1: a.y + a.h / 2,
        x2: b.x,
        y2: b.y + b.h / 2,
        stage: i,
      });
    }
  }
}

/* The return edge, dipped below the row so it cannot be confused with a
   forward connector. Endpoints come from the resolved loop rather than from
   array positions, so inserting a stage can no longer repoint it silently. */
const loopPath = (() => {
  if (!loop) return null;
  const fromBox = boxes[loop.fromIndex]?.[0];
  const toBox = boxes[loop.toIndex]?.[0];
  if (!fromBox || !toBox) return null;
  const startX = fromBox.x + fromBox.w / 2;
  const startY = fromBox.y + fromBox.h;
  const endX = toBox.x + toBox.w / 2;
  const endY = toBox.y + toBox.h;
  const dipY = height - 26;
  return {
    d: `M ${startX} ${startY} C ${startX} ${dipY}, ${endX} ${dipY}, ${endX} ${endY}`,
    labelX: (startX + endX) / 2,
    labelY: dipY + 4,
  };
})();

/**
 * The drawing's accessible name.
 *
 * Topology in a sentence: what leads to what, which stages run alongside each
 * other, and where the return path goes. It deliberately carries no detail
 * text, because the visible legend beside it already does, and repeating it
 * would make a screen reader read the whole architecture twice.
 */
const spoken = stages
  .map((stage) =>
    stage.nodes
      ? `${stage.nodes.map((node) => node.label).join(' and ')} in parallel`
      : stageLabel(stage),
  )
  .join(' leads to ');

const ariaLabel = `Architecture diagram: ${spoken}${
  loop ? `, with ${loop.label} routing back from ${loop.fromLabel} to ${loop.toLabel}` : ''
}.`;
---

<div class="arch" data-reveal="diagram">
  <svg class="arch-svg" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={ariaLabel}>
    <defs>
      <marker
        id="arch-arrow"
        viewBox="0 0 8 8"
        refX="7"
        refY="4"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M0,0 L8,4 L0,8 Z" class="arch-arrowhead" />
      </marker>
      <marker
        id="arch-arrow-oxide"
        viewBox="0 0 8 8"
        refX="7"
        refY="4"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M0,0 L8,4 L0,8 Z" class="arch-arrowhead-oxide" />
      </marker>
    </defs>

    {edges.map((edge) => (
      <line
        x1={edge.x1}
        y1={edge.y1}
        x2={edge.x2 - 8}
        y2={edge.y2}
        class="arch-edge arch-stage"
        style={`--stagger: ${edge.stage + 0.5}`}
        marker-end="url(#arch-arrow)"
      />
    ))}

    {loopPath && loop && (
      <>
        <path
          d={loopPath.d}
          class="arch-edge arch-loop arch-stage"
          style={`--stagger: ${boxes.length}`}
          marker-end="url(#arch-arrow-oxide)"
        />
        <text
          x={loopPath.labelX}
          y={loopPath.labelY}
          class="arch-loop-label arch-stage"
          style={`--stagger: ${boxes.length}`}
          text-anchor="middle"
        >
          {loop.label.toUpperCase()}
        </text>
      </>
    )}

    {boxes.map((stageBoxes, stageIndex) =>
      stageBoxes.map((box) => (
        <g class="arch-stage" style={`--stagger: ${stageIndex}`} data-stage={box.id}>
          <rect
            x={box.x}
            y={box.y}
            width={box.w}
            height={box.h}
            class:list={['arch-node', { 'is-gate': box.gate }]}
          />
          <text
            x={box.x + box.w / 2}
            y={box.y + box.h / 2}
            text-anchor="middle"
            class="arch-label"
          >
            {box.labelLines.map((line, li) => (
              <tspan
                x={box.x + box.w / 2}
                dy={li === 0 ? `${-((box.labelLines.length - 1) * 0.55)}em` : '1.1em'}
              >
                {line}
              </tspan>
            ))}
          </text>
        </g>
      )),
    )}
  </svg>
</div>

<style>
  .arch {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .arch-svg {
    width: 100%;
    height: auto;
  }

  .arch-node {
    fill: var(--color-paper);
    stroke: var(--color-ink);
    stroke-width: 1;
  }

  .arch-node.is-gate {
    stroke: var(--color-oxide-rule);
    stroke-width: 1.5;
  }

  .arch-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    fill: var(--color-ink);
    /* Labels sit on the geometric centre of their box. With detail text gone
       there is nothing below them to balance against, so the optical centre
       and the geometric one are close enough to leave alone. */
    dominant-baseline: middle;
  }

  .arch-edge {
    stroke: var(--color-graphite-rule);
    stroke-width: 1;
    fill: none;
  }

  .arch-loop {
    stroke: var(--color-oxide-rule);
  }

  .arch-loop-label {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.06em;
    fill: var(--color-oxide-text);
  }

  .arch-arrowhead {
    fill: var(--color-graphite-rule);
  }

  .arch-arrowhead-oxide {
    fill: var(--color-oxide-rule);
  }
</style>
