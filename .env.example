# ---------------------------------------------------------------------------
# Environment configuration for the portfolio.
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
# NEVER commit real credentials to this repository.
#
# Every variable below is declared in `astro.config.mjs` under `env.schema`,
# which validates them at build time and keeps secrets server-only.
# ---------------------------------------------------------------------------

# --- Email delivery (Resend) -----------------------------------------------
# Required for POST /api/contact to actually deliver mail.
# Without it the endpoint returns 503 and logs a warning; the build still works.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact submissions are delivered.
# Defaults to gautham.balajis@gmail.com if unset.
CONTACT_TO_EMAIL=gautham.balajis@gmail.com

# The From address Resend sends as.
# `onboarding@resend.dev` works for delivery to your own account address only.
# Production use requires a domain verified in Resend.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# --- Rate limiting (Upstash Redis) -----------------------------------------
# Optional. If either value is missing, rate limiting is skipped (fail-open)
# and a warning is logged. The contact endpoint still works.
# Create a database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
